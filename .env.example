# Required: generate with: openssl rand -hex 32
API_KEY=

# Optional. If empty, follow the device-login URL in docker compose logs.
QODER_PAT=

# INTL or CN; must match the PAT or Qoder account.
SOURCE=INTL

# Bind to loopback by default; use a trusted reverse proxy for remote access.
QODER_BIND=127.0.0.1
QODER_PORT=3000
